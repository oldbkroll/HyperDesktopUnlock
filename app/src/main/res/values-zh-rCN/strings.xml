<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">HyperDesktop Unlock</string>
    <string name="xposed_desc">在小米 HyperOS 4 / Android 17 上将外接显示器设为独立显示：恢复隐藏的桌面入口，阻止系统强制镜像。</string>
    <string name="status_active">设置即时生效。仅在安装或更新模块后需要重启。</string>
    <string name="status_unavailable">⚠ LSPosed 未提供设置存储位置。请重启后重新打开此页面。</string>
    <string name="status_inactive">⚠ 模块尚未在 LSPosed 中启用，设置无法传递给系统。请启用模块并勾选作用域：系统框架、系统界面、设置；重启后重新打开此页面。</string>
    <string name="section_dock">Dock 启动器</string>
    <string name="auto_launch_title">在外屏启动 Dock</string>
    <string name="auto_launch_summary">选择“电脑”模式时，在外屏打开 Dock 桌面。</string>
    <string name="launcher_pkg_title">Dock 应用包名</string>
    <string name="launcher_pkg_summary">SmartDock：cu.axel.smartdock · Taskbar：com.farmerbb.taskbar</string>
    <string name="extra_apps_title">同时在外屏打开应用</string>
    <string name="extra_apps_summary">连接后，在 Dock 启动完毕时打开这些应用。多个包名用空格或逗号分隔。</string>
    <string name="extra_apps_hint">com.android.chrome, org.videolan.vlc</string>
    <string name="manage_a11y_title">管理 Dock 无障碍服务</string>
    <string name="manage_a11y_summary">进入桌面时启用，断开外屏时停用，避免 Dock 出现在手机内屏。</string>
    <string name="section_phone">手机</string>
    <string name="phone_off_title">桌面模式下关闭手机内屏</string>
    <string name="phone_off_summary">手机继续运行。按两次电源键或按 Win+P 可恢复内屏。</string>
    <string name="touchpad_title">将手机用作触控板</string>
    <string name="touchpad_summary">桌面模式下内屏保持黑色并响应触摸：单指移动指针，轻点单击，双指滚动，双指轻点右击；轻点后再次按住并移动可拖动。三指触摸或 Win+P 可恢复手机界面。耗电略高于完全关闭内屏。</string>
    <string name="touchpad_sens_title">触控板灵敏度：%1$d / %2$d</string>
    <string name="touchpad_sens_summary">数值越大，相同手指移动距离对应的指针移动越远。松开滑块后生效，触控板运行时也可调整。系统指针速度和加速仍然适用。</string>
    <string name="keep_awake_title">保持外屏亮屏</string>
    <string name="keep_awake_summary">桌面模式下忽略自动息屏超时。如果未操作鼠标或键盘时外屏变黑，可启用此项。电源键仍然有效。</string>
    <string name="section_monitor">外接显示器</string>
    <string name="density_title">外屏显示密度（DPI）</string>
    <string name="density_summary">数值越大，界面越大。4K 显示器通常适合 240～360。0 表示显示器默认值；留空表示不修改。</string>
    <string name="density_invalid">请输入 0 或 100～800 之间的数值</string>
    <string name="field_apply">应用</string>
    <string name="field_saved">已保存。外屏已连接时立即应用，否则在下次连接时应用。</string>
    <string name="field_cleared">已清除，模块将不再修改此参数。</string>
    <string name="resolution_title">外屏分辨率</string>
    <string name="resolution_summary">逻辑分辨率，如 2560x1440 或 1920x1080。降低分辨率可放大界面并减轻 GPU 负载。0 表示原生分辨率；留空表示不修改。</string>
    <string name="resolution_invalid">请输入“宽x高”（如 1920x1080）或 0</string>
    <string name="refresh_title">外屏刷新率（Hz）</string>
    <string name="refresh_summary">仅在显示器声明支持当前分辨率下的该刷新率时应用（如 60）。0 表示原生值；留空表示不修改。</string>
    <string name="refresh_invalid">请输入刷新率（如 60）或 0</string>
    <string name="choose_leave">保持现状</string>
    <string name="choose_native">原生值</string>
    <string name="modes_hint">连接外屏后可选择其支持的模式。连接前可手动输入。</string>
    <string name="section_keyboard">键盘</string>
    <string name="shortcuts_title">桌面键盘快捷键</string>
    <string name="switcher_title">Alt+Tab 应用预览栏</string>
    <string name="switcher_summary">按住 Alt 查看外屏已打开的应用，松开 Alt 切换。关闭后，每次按 Tab 立即切换。</string>
    <string name="old_package_warning">检测到旧版 HyperDesktop Unlock（io.maurizio.hyperdesktop，1.12.7 及更早版本）。请卸载旧版，避免两个模块同时在 LSPosed 中启用而重复执行 Hook。然后确认本版已启用，作用域为系统框架、系统界面、设置，并重启。</string>
    <string name="old_package_button">打开旧版应用信息</string>
    <string name="ime_warning">当前连接了实体键盘，同时启用了“显示屏幕键盘”。某些外屏应用可能要在锁定并解锁手机后才显示输入的文字（Delete 和 Backspace 仍有效）。</string>
    <string name="ime_warning_button">关闭屏幕键盘选项</string>
    <string name="ime_warning_done">已关闭“显示屏幕键盘”</string>
    <string name="ime_warning_failed">修改失败，请在实体键盘设置中关闭“显示屏幕键盘”</string>
    <string name="fit_status_bar_title">让应用避开外屏状态栏（实验性）</string>
    <string name="fit_status_bar_summary">某些应用会绘制到外屏状态栏下方，导致顶部内容被遮挡。启用后，外屏应用窗口将从状态栏下方开始，全屏视频仍保持全屏。仅对启用后打开的应用生效。</string>
    <string name="shortcuts_list">Alt+Tab · Alt+Shift+Tab — 切换外屏应用\nPrint Screen · Win+Shift+S — 外屏截图\nWin+Shift+方向键 — 在外屏与手机间移动应用\nAlt+F4 — 关闭外屏应用\nWin+D — 显示 Dock 桌面\nWin+Backspace — 返回\nWin+1…9 — 聚焦第 N 个应用\nWin+P — 开关手机内屏</string>
    <string name="section_updates">更新</string>
    <string name="updates_checking">正在检查更新…</string>
    <string name="updates_latest">当前已是最新版本（v%1$s）。</string>
    <string name="updates_available">发现更新：%1$s，点按打开发布页面。</string>
    <string name="updates_error">无法检查更新，点按打开发布页面。</string>
    <string name="touchpad_back_title">触控板返回手势</string>
    <string name="touchpad_back_summary">从手机左右边缘向内滑动，可在外屏执行返回。如果影响指针移动，可关闭此项。</string>
    <string name="phone_keyboard_title">在手机上显示键盘</string>
    <string name="phone_keyboard_summary">触控板启用时，点按外屏文本框可在手机触控板下方显示屏幕键盘。连接实体键盘时，Android 通常不显示屏幕键盘。</string>
    <string name="tiles_hint">可在通知栏编辑快捷设置，添加“外接显示器”（电脑 ↔ 镜像）和“触控板”磁贴。</string>
    <string name="section_diag">诊断</string>
    <string name="diag_checking">正在检查系统中的模块状态…</string>
    <string name="diag_ok">系统模块正在运行（v%1$s），所有组件均已挂接。</string>
    <string name="diag_reboot">系统仍在运行 v%1$s，请重启以加载 v%2$s。</string>
    <string name="diag_missing">部分组件未挂接：%1$s。请生成诊断报告并在 GitHub 反馈。</string>
    <string name="diag_no_answer">系统未响应，模块可能尚未加载。安装或更新后请重启；重启后约需等待一分钟。</string>
    <string name="diag_report_button">生成诊断报告</string>
    <string name="diag_note">报告包含手机型号、Android 和 HyperOS 版本、模块设置及近期日志。连接外屏时，还会包含外屏应用和窗口标题。报告不会自动发送，由你选择复制或分享。</string>
    <string name="diag_collecting">正在收集…</string>
    <string name="diag_report_title">诊断报告</string>
    <string name="diag_copy">复制</string>
    <string name="diag_share">分享</string>
